<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/vw_clip" android:clipToOutline="true">
    <ImageView android:id="@+id/bgimg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
<LinearLayout android:id="@+id/inner" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/ring" android:layout_width="60dp" android:layout_height="60dp" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/lab" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10.5sp" android:letterSpacing="0.1" android:textColor="@color/vw_on2" android:maxLines="1" android:ellipsize="end" android:text="PROSSIMA TAPPA"/>
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/vw_on" android:maxLines="2" android:ellipsize="end" android:text="Viaticum"/>
            <Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/vw_on"/>
            <TextView android:id="@+id/when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/vw_on" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <ViewFlipper android:id="@+id/flip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:autoStart="true" android:flipInterval="3500" android:inAnimation="@anim/vw_in" android:outAnimation="@anim/vw_out"/>
        <TextView android:id="@+id/go" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="8dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center" android:background="@drawable/vw_btn_w" android:textColor="@color/vw_ink_d" android:textStyle="bold" android:textSize="13sp" android:text="Portami lì"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
