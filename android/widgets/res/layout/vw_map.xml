<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/vw_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="10dp" android:padding="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/vw_cap">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/cap_t" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/vw_ink" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/cap_s" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11.5sp" android:textColor="@color/vw_mute" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/go" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center" android:background="@drawable/vw_btn" android:textColor="@color/vw_onacc" android:textStyle="bold" android:textSize="13sp" android:text="Vai"/>
    </LinearLayout>
</FrameLayout>
