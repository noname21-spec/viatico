<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/vw_clip" android:clipToOutline="true">
    <ImageView android:id="@+id/bgimg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
<LinearLayout android:id="@+id/inner" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/lab" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10.5sp" android:letterSpacing="0.1" android:textColor="@color/vw_on2" android:maxLines="1"/>
            <TextView android:id="@+id/res" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/vw_on" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11.5sp" android:textColor="@color/vw_on2" android:maxLines="1"/>
        </LinearLayout>
        <TextView android:id="@+id/go" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="8dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center" android:background="@drawable/vw_btn_w" android:textColor="@color/vw_ink_d" android:textStyle="bold" android:textSize="13sp" android:text="Converti"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/q1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/vw_glass" android:textSize="12.5sp" android:textStyle="bold" android:textColor="@color/vw_on"/>
        <TextView android:id="@+id/q2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/vw_glass" android:textSize="12.5sp" android:textStyle="bold" android:textColor="@color/vw_on"/>
        <TextView android:id="@+id/q3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/vw_glass" android:textSize="12.5sp" android:textStyle="bold" android:textColor="@color/vw_on"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
