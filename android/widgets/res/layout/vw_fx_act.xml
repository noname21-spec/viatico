<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/fx_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000">
    <LinearLayout android:id="@+id/fx_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="24dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/vw_bg">
        <TextView android:id="@+id/fx_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/vw_ink"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:background="@drawable/vw_field">
            <EditText android:id="@+id/fx_in" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@null" android:inputType="numberDecimal" android:digits="0123456789.," android:imeOptions="actionDone" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/vw_ink" android:hint="0" android:textColorHint="@color/vw_mute" android:importantForAutofill="no"/>
            <TextView android:id="@+id/fx_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/vw_mute"/>
        </LinearLayout>
        <TextView android:id="@+id/fx_dir" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="10dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center" android:background="@drawable/vw_field" android:textColor="@color/vw_acc" android:textStyle="bold" android:textSize="14sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="11sp" android:letterSpacing="0.1" android:textColor="@color/vw_mute" android:text="DIVENTANO"/>
        <TextView android:id="@+id/fx_res" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/vw_acc"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11.5sp" android:textColor="@color/vw_mute" android:text="Cambio indicativo: in negozio o in banca può essere un po' diverso."/>
        <TextView android:id="@+id/fx_close" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp" android:gravity="center" android:background="@drawable/vw_btn" android:textColor="@color/vw_onacc" android:textStyle="bold" android:textSize="15sp" android:text="Fatto"/>
    </LinearLayout>
</FrameLayout>
