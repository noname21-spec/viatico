<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/vw_clip" android:clipToOutline="true">
    <ImageView android:id="@+id/bgimg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
<LinearLayout android:id="@+id/inner" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
    <ImageView android:id="@+id/donut" android:layout_width="88dp" android:layout_height="88dp" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/lab" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10.5sp" android:letterSpacing="0.1" android:textColor="@color/vw_on2" android:maxLines="1" android:text="SPESE"/>
        <TextView android:id="@+id/tot" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/vw_on" android:text="0 €"/>
        <TextView android:id="@+id/est" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/vw_on2" android:maxLines="1" android:ellipsize="end"/>
        <ViewFlipper android:id="@+id/flip" android:layout_width="match_parent" android:layout_height="wrap_content" android:autoStart="true" android:flipInterval="3500" android:inAnimation="@anim/vw_in" android:outAnimation="@anim/vw_out" android:layout_marginTop="8dp"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
