<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFFFF" android:fitsSystemWindows="true" android:padding="18dp">
    <TextView android:id="@+id/qr_back" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="@drawable/vw_qr_btn" android:textColor="#FF1A1416" android:textStyle="bold" android:textSize="17sp" android:text="‹  Indietro"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/qr_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FF1A1416" android:textStyle="bold" android:textSize="24sp"/>
        <TextView android:id="@+id/qr_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#FF6B5A58" android:textSize="15sp"/>
        <ImageView android:id="@+id/qr_img" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="Codice del biglietto"/>
    </LinearLayout>
</LinearLayout>
