{"id":"./","name":"Viaticum","short_name":"Viaticum","description":"Il tuo viaggio, tappa dopo tappa: itinerario per 44 città europee, la tappa in corso, pasti e spese divise tra amici. Anche senza rete.","start_url":"./?src=pwa","scope":"./","display":"standalone","display_override":["standalone","minimal-ui"],"orientation":"any","background_color":"#f4f5f8","theme_color":"#14224f","lang":"it","dir":"ltr","categories":["travel","navigation","lifestyle"],"icons":[{"src":"icon-192.png?v=3","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"icon-512.png?v=3","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"icon-maskable-512.png?v=3","sizes":"512x512","type":"image/png","purpose":"maskable"}],"share_target":{"action":"./?share-target=1","method":"POST","enctype":"multipart/form-data","params":{"title":"title","text":"text","files":[{"name":"f","accept":["image/*","application/pdf",".pdf"]}]}},"screenshots":[{"src":"screenshots/1-home.jpg","sizes":"880x1912","type":"image/jpeg","form_factor":"narrow","label":"Il prossimo viaggio con il conto alla rovescia"},{"src":"screenshots/2-adesso.jpg","sizes":"880x1912","type":"image/jpeg","form_factor":"narrow","label":"La tappa in corso e «Portami lì»"},{"src":"screenshots/3-tappe.jpg","sizes":"880x1912","type":"image/jpeg","form_factor":"narrow","label":"Il giorno, tappa per tappa"},{"src":"screenshots/4-pasti.jpg","sizes":"880x1912","type":"image/jpeg","form_factor":"narrow","label":"Dove mangiare vicino alle tappe"},{"src":"screenshots/5-spese.jpg","sizes":"880x1912","type":"image/jpeg","form_factor":"narrow","label":"Costi e spese divise"},{"src":"screenshots/7-dove-vai.jpg","sizes":"880x1912","type":"image/jpeg","form_factor":"narrow","label":"44 città con guida"}]}